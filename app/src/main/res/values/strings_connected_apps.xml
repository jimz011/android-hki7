    <string name="tidyshop_server_hint">https://tidyshop.example.com</string>
    <string name="tidyshop_display_name_label">Your name</string>
    <string name="tidyshop_code_label">Invite or device code</string>
    <string name="tidyshop_code_hint">An invite adds you to the family. A device code adds this phone to the member you already are. A recovery code works here too.</string>
    <string name="tidyshop_pairing_key_label">Master pairing key</string>
    <string name="tidyshop_pairing_key_hint">Only if you run the server yourself and have no code to hand.</string>
    <string name="tidyshop_connect">Connect</string>
