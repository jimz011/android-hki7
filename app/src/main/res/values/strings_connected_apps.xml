<?xml version="1.0" encoding="utf-8"?>
<!--
  Connected apps: other apps of this family that HKI 7 can pull data from, listed under their own
  settings category so the next one to plug in is an entry there rather than a new category.

  TidyShop is the first. Its family connector is self-hosted, and this device proves who it is with
  a key generated in the Android Keystore rather than with a password, so the wording below talks
  about codes and devices rather than about signing in.
-->
<resources>
    <!-- Category -->
    <string name="settings_title_connected_apps">Connected apps</string>
    <string name="settings_subtitle_connected_apps">Other apps this dashboard can show</string>
    <string name="connected_apps_summary_connected">%1$s is connected</string>

    <!-- TidyShop row -->
    <string name="connected_apps_tidyshop">TidyShop</string>
    <string name="connected_apps_tidyshop_subtitle">Shared shopping lists for the whole family</string>
    <string name="connected_apps_tidyshop_connected">Connected to %1$s</string>
    <string name="settings_title_tidyshop">TidyShop</string>
    <string name="settings_subtitle_tidyshop">Family shopping lists from your own connector</string>

    <!-- Connecting -->
    <string name="tidyshop_connect_intro">Enter the address of your family connector and a code from it. Ask whoever set it up for an invite, or use a device code from another of your own phones.</string>
