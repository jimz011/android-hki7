<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal blue gradient for the adaptive-icon background layer, replacing the flat
     @color/ic_launcher_background. This layer is shown only for the normal (colored) icon;
     themed/monochrome icons ignore it entirely and use the <monochrome> silhouette, so the
     gradient has no effect on themed rendering. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="8"
                android:endX="100"
                android:endY="100"
                android:startColor="#2B72D4"
                android:endColor="#123A96" />
        </aapt:attr>
    </path>
</vector>
